# Configuración LOCAL de la base de datos: cada quien ajusta estos valores a su computadora.
# (No subir ni compartir este archivo con su contraseña real.)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bd_aplicacion_movil_pro

# SESIONES: clave secreta con la que se firman los tokens (mínimo 32 caracteres).
# Cada quien genera la suya con este comando y pega el resultado aquí:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sin esta clave la API no arranca. Si la cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=
